{% comment %}
  Local override of al_folio_core's _includes/news.liquid.

  Only difference from the gem version: the date column honours a per-item
  `date_precision` front matter key, so an entry never shows a day — or a month —
  that was not actually known.

    date_precision: year   ->  2022
    (anything else)        ->  Oct 2022

  Every item still needs a full `date` because Jekyll sorts the collection by it;
  the day is simply never rendered.
{% endcomment %}
<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign news = site.news | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <tr>
            <th scope="row" style="width: 20%">
              {% if item.date_precision == 'year' %}
                {{ item.date | date: '%Y' }}
              {% else %}
                {{ item.date | date: '%b %Y' }}
              {% endif %}
            </th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
